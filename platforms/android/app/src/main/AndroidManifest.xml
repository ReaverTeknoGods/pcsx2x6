<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="archos.permission.FULLSCREEN.FULL" />
    <!-- Cover artwork can be loaded from the configured remote artwork source. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Optional motion controls (Pad settings). Not required, so the Play install
         isn't gated for devices without a gyroscope. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:name=".Pasx2Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@style/Theme.ARMSX2"
        android:allowNativeHeapPointerTagging="false"
        tools:targetApi="31"
        >
        <!-- Declare game mode support (Android 12+) — routes app through GameManager
             performance profile so the OS scheduler and CPU/GPU governors prefer
             big cores and peak clocks instead of throttling as a normal app. -->
        <meta-data android:name="android.app.game_mode" android:value="performance" />

        <!-- Profileable from the adb shell. Lets simpleperf record from the
             release build without flipping debuggable on (which would also
             change the JIT path and skew the numbers). -->
        <profileable android:shell="true" tools:targetApi="29" />

        <meta-data android:name="android.max_aspect" android:value="2.4" />

        <activity
            android:name=".BootSplashActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:exported="false"
            android:resizeableActivity="false"
            android:theme="@style/Theme.ARMSX2.Boot" />

        <!-- PCSX2X6 is a private TPUI companion, not a standalone Android
             launcher. The explicit activity remains exported only for TPUI's
             signature-protected launch intent. -->
        <activity
            android:name=".Main"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:permission="com.teknoparrot.permission.BIND_BRIDGE"
            android:resizeableActivity="false" />

        <activity-alias
            android:name=".MainActivity"
            android:exported="false"
            android:targetActivity=".Main" />

        <receiver
            android:name=".RetroAchievementsHostOverrideReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.SET_RETROACHIEVEMENTS_HOST_OVERRIDE" />
                <action android:name="${applicationId}.action.CLEAR_RETROACHIEVEMENTS_HOST_OVERRIDE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TeknoParrotSessionControlReceiver"
            android:exported="true"
            android:permission="com.teknoparrot.permission.BIND_BRIDGE">
            <intent-filter>
                <action android:name="com.teknoparrot.pcsx2x6.action.QUERY_SESSION" />
                <action android:name="com.teknoparrot.pcsx2x6.action.STOP_GAME" />
                <action android:name="com.teknoparrot.pcsx2x6.action.QUERY_CATALOG" />
            </intent-filter>
        </receiver>
    </application>



</manifest>
